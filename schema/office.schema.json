{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/grokbot-visual-office/office.schema.json",
  "title": "Grokbot Visual Office data",
  "description": "What the pixel office renders. Produce this JSON from any agent system (or write an adapter).",
  "type": "object",
  "required": ["agents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "office": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Shown in the top bar." },
        "updatedAt": { "type": "string", "format": "date-time" },
        "demo": { "type": "boolean", "description": "Demo data: timestamps are shifted so updatedAt == now." }
      }
    },
    "projects": {
      "type": "array",
      "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } }
    },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } }
  },
  "$defs": {
    "status": { "enum": ["working", "idle", "stuck", "waiting_approval", "offline", "done"] },
    "agent": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Accent: headphones / ear lights / shirt." },
        "kind": { "enum": ["ai", "human"], "default": "ai" },
        "isBoss": { "type": "boolean", "description": "Sits on the central command platform. Default: none." },
        "seat": { "type": "integer", "description": "Optional desk id from the layout (1-based)." },
        "status": { "$ref": "#/$defs/status" },
        "currentTask": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"], "description": "Project id. 2+ working agents on the same project within 3 h hold a meeting." },
        "lastActive": { "type": ["string", "null"], "format": "date-time" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "enum": ["running", "done", "queued", "stuck", "cancelled", "archived"] },
        "project": { "type": ["string", "null"] },
        "projectName": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "doneAt": { "type": ["string", "null"], "format": "date-time" },
        "progress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "note": { "type": ["string", "null"] },
        "subtasks": {
          "type": "array",
          "items": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" }, "status": { "enum": ["todo", "running", "done", "stuck"] } } }
        },
        "confirms": {
          "type": "array",
          "description": "Questions the agent needs a human to answer. A plain string is accepted as a pending question.",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "type": "object", "required": ["question"], "properties": { "id": { "type": "string" }, "question": { "type": "string" }, "status": { "enum": ["pending", "answered"] } } }
            ]
          }
        }
      }
    }
  }
}
